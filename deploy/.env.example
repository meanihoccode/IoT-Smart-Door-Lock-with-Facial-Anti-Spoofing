# Copy to deploy/.env on the server and fill in. Never commit deploy/.env.
# Placeholders only: no real domain, account or secret is configured in the repository (D06 still open).

# Public DNS name pointing at the VM; Caddy obtains a Let's Encrypt certificate for it.
SMARTLOCK_DOMAIN=smartlock.example.com
ACME_EMAIL=admin@example.com

# MySQL (private network only). Use long random values.
MYSQL_DATABASE=btl_iot
MYSQL_USER=smartlock
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Host path containing models/buffalo_l/*.onnx (e.g. a copy of ~/.insightface).
INSIGHTFACE_MODELS_DIR=/opt/smartlock/insightface

# Broker account used by Core; must match the "core" entry in mosquitto/config/passwd.
MQTT_CORE_PASSWORD=

# Door node. Generate with scripts/new-device-credentials.sh; put only the SHA-256 here.
DEVICE_ID=door-01
DEVICE_TOKEN_SHA256=

# First start only: creates the admin when no admin exists. Remove the password after the first login.
ADMIN_USERNAME=
ADMIN_PASSWORD=
